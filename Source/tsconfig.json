{
	"compilerOptions": {
		"baseUrl": "./",
		"declaration": true,
		"inlineSources": false,
		"lib": [
			"es2017"
		],
		"module": "commonjs",
		"moduleResolution": "node",
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "Target",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"stripInternal": true,
		"target": "es2017"
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"src",
		"src"
	]
}
